VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FAMILY_ID=

# Set to false for local-only mode (no Firebase auth or Firestore sync calls).
VITE_ENABLE_FIREBASE_SYNC=true

# Optional: use production-only to allow Firebase sync only in production builds.
# Allowed values: all, production-only
VITE_FIREBASE_SYNC_MODE=all
